{
  "name": "arena-graphics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "description": "ARENA GRAPHICS — local-first MLBB broadcast graphics engine",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @arena/server --filter @arena/web dev",
    "dev:server": "pnpm --filter @arena/server dev",
    "dev:web": "pnpm --filter @arena/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @arena/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:obs": "pnpm --filter @arena/server test:obs",
    "test:unit": "pnpm --filter @arena/graphics-core test -- --run",
    "test:integration": "node scripts/integration-suite.mjs",
    "test:overlays": "node scripts/verify-overlays.mjs",
    "test:transparency": "node scripts/verify-overlay-transparency.mjs",
    "test:templates": "node scripts/phase6-smoke.mjs",
    "demo:screenshots": "node scripts/demo-screenshots.mjs",
    "db:generate": "pnpm --filter @arena/server db:generate",
    "db:migrate": "pnpm --filter @arena/server db:migrate",
    "db:seed": "pnpm --filter @arena/server db:seed",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup.ps1",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
