# ARENA GRAPHICS — server configuration
# Copy this file to `.env` in the project root. Never commit `.env`.

# Local-only bind address. Keep 127.0.0.1 unless you intentionally add LAN access.
HOST=127.0.0.1
PORT=4000

# Frontend origin allowed to call the API / open Socket.IO connections.
WEB_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Optional. Defaults to %LOCALAPPDATA%\ArenaGraphics on Windows.
# ARENA_DATA_DIR=C:\Users\YourName\AppData\Local\ArenaGraphics

# Optional. Defaults to a SQLite file inside ARENA_DATA_DIR.
# Use a libsql-compatible URL, for example: file:C:/data/arena.sqlite
# DATABASE_URL=file:C:/Users/YourName/AppData/Local/ArenaGraphics/arena.sqlite

# OBS WebSocket settings (Phase 5). Credentials stay server-side only and are
# never returned to browser clients. Enable "WebSocket Server" in OBS first.
OBS_HOST=127.0.0.1
OBS_PORT=4455
OBS_PASSWORD=
# Optional: connect to OBS automatically on server startup.
OBS_AUTO_CONNECT=false

# SQLite file path (created automatically). Defaults to data/arena.sqlite in the workspace.
# DATABASE_URL=file:data/arena.sqlite
